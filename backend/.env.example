# Copiar a .env y ajustar. NUNCA subir el .env real al repositorio.

ENVIRONMENT=development

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://dolga:cambiar@localhost:5432/dolga

# Firma de los tokens de sesión de la SuperApp
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria

# Cifrado de las credenciales de los equipos (MikroTik / UISP / OLT).
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVICE_SECRET_KEY=

# Orígenes permitidos para el frontend React
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Timeout por defecto al hablar con los routers (segundos)
MIKROTIK_TIMEOUT=8

# Monitoreo. RouterOS no guarda histórico: estas muestras son las que alimentan
# las gráficas de tráfico y las minigráficas de CPU.
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=30
MONITOR_RETENTION_HOURS=72
